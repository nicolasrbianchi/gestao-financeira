# (Opcional em dev) URL do Apps Script publicado como Web App (/exec)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Fonte de dados: appsScript | db
DATA_SOURCE=appsScript
# TTL curto para deduplicar leituras concorrentes do DB no carregamento do app.
DB_READ_CACHE_TTL_MS=10000

# (Quando DATA_SOURCE=db)
DATABASE_URL=
# (Supabase normalmente exige)
DATABASE_SSL=true

# Se yes/true/1: aplica schema.sql automaticamente no boot do servidor (útil no deploy)
# Obs: protegido com pg_advisory_lock para evitar corrida entre múltiplas instâncias.
DB_PUSH_ON_DEPLOY=

# Pluggy / MeuPluggy (Open Finance)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Token simples (opcional) para proteger o endpoint do webhook:
PLUGGY_WEBHOOK_TOKEN=
# Token obrigatório para /api/pluggy/cron/fetch-transactions (UptimeRobot/cron externo)
PLUGGY_SYNC_TOKEN=
# Se vazio, o backend tenta inferir pela request (protocol/host).
PLUGGY_WEBHOOK_URL=
# Se true, o próprio backend busca transações Pluggy periodicamente enquanto o processo estiver vivo.
PLUGGY_AUTO_FETCH_ENABLED=
PLUGGY_AUTO_FETCH_INTERVAL_MS=300000
PLUGGY_AUTO_FETCH_INITIAL_DELAY_MS=45000

# Login do app (sessão via cookie)
APP_LOGIN=admin
APP_PASSWORD=admin

# Obrigatório em produção
SESSION_SECRET=change-me

# Se true e não houver Apps Script configurado, usa dados mock para rodar a UI
USE_MOCK_DATA=true

NODE_ENV=development
